{
  "name": "pr-diff-line-count",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "description": "Count the code lines a pull request changes, with comments, blank lines, tests and generated files separated.",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs",
    "format": "biome check . --fix && pnpm format:md",
    "format:md": "prettier --write \"**/*.md\"",
    "lint": "biome check .",
    "lint:md": "prettier --check \"**/*.md\"",
    "ts:check": "tsc",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "check": "pnpm ts:check && pnpm lint && pnpm lint:md",
    "cloc:check": "tsx script/check-cloc-version.ts"
  },
  "dependencies": {
    "@actions/core": "^3",
    "@actions/exec": "^3",
    "@actions/github": "^9",
    "@actions/tool-cache": "^4",
    "es-toolkit": "^1",
    "picomatch": "^4",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^22",
    "@types/picomatch": "^4",
    "esbuild": "^0.28",
    "prettier": "^3",
    "tsx": "^4",
    "type-fest": "^5",
    "typescript": "^7",
    "vitest": "^5"
  }
}
