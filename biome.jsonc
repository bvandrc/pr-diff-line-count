{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.json"],
  "files": {
    // The committed action bundle is esbuild's output, not ours to lint or format.
    // It needs an explicit exclusion rather than .gitignore, since a JS action has
    // to commit its build.
    "includes": ["**", "!!conventions", "!dist"]
  },
  "markdown": {
    // Enforces the no-hard-wrap rule in conventions/all.md: a hard-wrapped
    // paragraph is unwrapped rather than passed. Safe here because every
    // multi-line run of text in our markdown is a list or a table.
    "formatter": { "proseWrap": "never" }
  }
}
